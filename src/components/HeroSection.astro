---
---
<!-- Full-viewport hero — 背景由共用的 #stage-bg 提供(透明,讓 fixed 幻燈片透出) -->
<section id="hero" class="relative z-10 w-full h-screen overflow-hidden">

  <!-- [z-1] Frosted glass panel — backdrop-filter + tint directly on panel -->
  <!-- 玻璃質感色塊層 (z-10) -->
  <div id="hero-glass" class="absolute z-10 pointer-events-none rounded-xl sm:rounded-2xl md:rounded-3xl overflow-hidden"
    style="top: 2.5vh; bottom: 2.5vh; left: 2.5vw; right: 2.5vw;
           background: rgba(229, 0, 78, 0.55);
           backdrop-filter: blur(48px) saturate(180%);
           -webkit-backdrop-filter: blur(48px) saturate(180%);
           border: 1px solid rgba(255, 255, 255, 0.15);
           box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1), inset 0 2px 20px rgba(255, 255, 255, 0.15);">
    
    <!-- Subtle highlight skin -->
    <div class="absolute inset-0 pointer-events-none" style="background: rgba(255,255,255,0.03);"></div>
    
    <!-- Diagonal light rake -->
    <div class="absolute inset-0 pointer-events-none" style="background: linear-gradient(135deg, rgba(255,255,255,0.25) 0%, rgba(255,255,255,0.05) 20%, rgba(0,0,0,0) 50%, rgba(0,0,0,0.1) 100%);"></div>

    <!-- Grain -->
    <div class="absolute inset-0 pointer-events-none" style="opacity:0.04; background-image:url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22300%22 height=%22300%22><filter id=%22n%22><feTurbulence type=%22fractalNoise%22 baseFrequency=%220.85%22 numOctaves=%224%22 stitchTiles=%22stitch%22/></filter><rect width=%22300%22 height=%22300%22 filter=%22url(%23n)%22/></svg>'); background-size:300px 300px;"></div>
  </div>

  <!-- SCROLL cue — 引導使用者向下滾動進入畫廊 -->
  <div id="scroll-cue" class="absolute left-1/2 -translate-x-1/2 bottom-[5.5vh] z-30 flex flex-col items-center gap-3 pointer-events-none select-none">
    <span class="scroll-cue-label" style="text-indent:0.5em;">SCROLL</span>
    <span class="scroll-cue-track">
      <span class="scroll-cue-drop"></span>
    </span>
  </div>

  <!-- Title ABOVE glass panel (z-20) -->
  <div class="absolute z-20 pointer-events-none select-none flex items-center justify-center w-[95vw] md:w-[47.5vw]"
    style="top: 2.5vh; bottom: 2.5vh; left: 2.5vw;">
    <img id="hero-title" src={import.meta.env.BASE_URL + "images/towandigitalimage.png"} alt="TOWAN DIGITAL IMAGE"
      style="height:clamp(7rem,45vw,26rem); width:auto; max-width:90%; object-fit:contain; filter:drop-shadow(0 2px 32px rgba(160,20,50,0.35));" />
  </div>

</section>

<style>
  .scroll-cue-label {
    font-size: 0.55rem;
    letter-spacing: 0.5em;
    color: rgba(255, 255, 255, 0.55);
  }
  .scroll-cue-track {
    position: relative;
    display: block;
    width: 24px;
    height: 38px;
    border-radius: 12px;
    border: 1.5px solid rgba(255, 255, 255, 0.55);
  }
  .scroll-cue-drop {
    position: absolute;
    left: 50%;
    top: 6px;
    width: 4px;
    height: 8px;
    margin-left: -2px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 0 6px rgba(255, 255, 255, 0.5);
    animation: wheel-scroll 2s ease-in-out infinite;
  }
  @keyframes wheel-scroll {
    0%   { transform: translateY(0); opacity: 1; }
    55%  { transform: translateY(14px); opacity: 0; }
    56%  { transform: translateY(0); opacity: 0; }
    75%  { opacity: 1; }
    100% { transform: translateY(0); opacity: 1; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import Lenis from 'lenis';

  document.addEventListener('astro:page-load', () => {
    if (!document.getElementById('hero-title')) return;

    // 幻燈片改由共用的 #stage-bg 播放(見 StageBackground.astro)

    // ── Hero title entrance ──
    gsap.from('#hero-title', {
      opacity: 0, y: 60, duration: 1.4, ease: 'power3.out', delay: 0.4,
    });

  });
</script>
