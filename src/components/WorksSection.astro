---
import { readFileSync } from 'fs';
import { join } from 'path';

const projects = JSON.parse(readFileSync(join(process.cwd(), 'src/pages/works/index.json'), 'utf-8'));

const pinkCard = { isPink: true, title: 'TOWAN', category: '', image: '' };

const col1 = [pinkCard, ...projects.filter((_, i) => i % 2 === 0), pinkCard].reverse();
const col2 = [pinkCard, ...projects.filter((_, i) => i % 2 === 1), pinkCard];
const mobileCol = [pinkCard, ...projects, pinkCard];

function renderTile(p: any, isLeftCol: boolean) {
  if (p.isPink) {
    return `
      <div class="tile-wrapper relative w-full">
        <div class="pink-card block w-full relative aspect-[3/4] flex items-center justify-center pointer-events-none" style="
          background: rgba(229, 0, 78, 0.85);
          backdrop-filter: blur(12px) saturate(150%);
          -webkit-backdrop-filter: blur(12px) saturate(150%);
        ">
          <div class="absolute inset-0 pointer-events-none" style="background: rgba(255,255,255,0.05);"></div>
          <div class="absolute inset-0 pointer-events-none" style="background: linear-gradient(130deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0) 40%, rgba(0,0,0,0.02) 100%);"></div>
          <img src="${import.meta.env.BASE_URL}images/towanlogoindex.png" alt="TOWAN" class="relative z-10 w-2/5 max-w-[140px] h-auto object-contain" />
        </div>
      </div>
    `;
  }

  const cover = p.image;
  if(!cover) return '';
  
  const textPosition = isLeftCol ? "right-[calc(100%+2vw)] text-right items-end" : "left-[calc(100%+2vw)] text-left items-start";
  const colClass = isLeftCol ? "-left-col" : "-right-col";

  const descClass = isLeftCol 
    ? "right-[100%] w-[16vw] pr-6 text-right" 
    : "left-[100%] w-[16vw] pl-6 text-left";

  const isAbsolute = cover.startsWith('http');
  const srcUrl = isAbsolute ? cover : `${import.meta.env.BASE_URL}${cover.replace(/^\//, '')}`;

  return `
    <div class="tile-wrapper relative w-full">
      <a href="${import.meta.env.BASE_URL}works/${p.id}" class="tile ${colClass} block w-full relative cursor-pointer no-underline group text-black">
        <div class="tile-inner w-full relative h-full">
          <img src="${srcUrl}" alt="${p.title}" class="w-full h-auto block object-cover" />
        </div>
        
        <div class="tile-info hidden md:flex absolute top-1/2 -translate-y-1/2 w-max flex-col gap-1 text-[0.65rem] tracking-[0.15em] uppercase opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none ${textPosition}">
          <span class="text-neutral-500 whitespace-nowrap">${p.category}</span>
          <span class="font-bold text-sm whitespace-nowrap">${p.title}</span>
        </div>
      </a>
      
      <div class="tile-desc absolute top-[calc(100%+17.5%+12px)] ${descClass} opacity-0 transition-opacity duration-700 pointer-events-none z-0">
        <p class="text-[0.65rem] leading-relaxed text-neutral-500 tracking-[0.05em] uppercase font-medium">${p.description || ''}</p>
      </div>
    </div>
  `;
}

const chunkCol1 = `<div class="chunk w-full flex flex-col gap-[4px] pb-[4px]">${col1.map(p => renderTile(p, true)).join('')}</div>`;
const chunkCol2 = `<div class="chunk w-full flex flex-col gap-[4px] pb-[4px]">${col2.map(p => renderTile(p, false)).join('')}</div>`;
const chunkMobile = `<div class="chunk w-full flex flex-col gap-[4px] pb-[4px]">${mobileCol.map(p => renderTile(p, false)).join('')}</div>`;
---

<section id="works-section" class="relative w-full bg-white text-black min-h-screen">
  
  <!-- Mobile: Normal Native Scroll -->
  <div class="md:hidden w-[85vw] mx-auto py-[12vh] flex flex-col">
    <div set:html={chunkMobile} />
  </div>

  <!-- Desktop: ScrollTrigger Pinned Virtual Scroll -->
  <div id="works-desktop" class="hidden md:flex h-screen w-full justify-center items-center overflow-hidden relative">
    <div class="flex gap-[4px] h-full items-center w-full justify-center">
      <!-- Col 1 -->
      <div class="col-wrap w-[22vw] max-w-[320px] h-full relative" id="col1-wrap">
        <div class="col-inner absolute top-0 left-0 w-full" set:html={chunkCol1} id="col1-inner" />
      </div>
      
      <!-- Col 2 -->
      <div class="col-wrap w-[22vw] max-w-[320px] h-full relative" id="col2-wrap">
        <div class="col-inner absolute top-0 left-0 w-full" set:html={chunkCol2} id="col2-inner" />
      </div>
    </div>
  </div>

</section>

<style>
  :global(.tile-wrapper) {
    transition: transform 0.8s cubic-bezier(0.19, 1, 0.22, 1);
  }
  :global(.tile) {
    transition: transform 0.8s cubic-bezier(0.19, 1, 0.22, 1);
    position: relative;
    z-index: 1;
  }
  :global(.tile.-left-col) { transform-origin: center right; }
  :global(.tile.-right-col) { transform-origin: center left; }
  :global(.tile.-active) {
    transform: scale(1.35) !important;
    z-index: 50 !important;
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
  }
  :global(#works-desktop.-locked .tile-info) { opacity: 0 !important; }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('astro:page-load', () => {
    const worksSection = document.getElementById('works-section');
    if (!worksSection) return;

    let mm = gsap.matchMedia();

    mm.add("(min-width: 768px)", () => {
      const col1Inner = document.getElementById('col1-inner');
      const col2Inner = document.getElementById('col2-inner');
      const worksDesktop = document.getElementById('works-desktop');
      
      if(!col1Inner || !col2Inner || !worksDesktop) return;

      const h1 = col1Inner.getBoundingClientRect().height;
      const h2 = col2Inner.getBoundingClientRect().height;
      const winH = window.innerHeight;

      // Ensure images are fully loaded before finalizing heights
      // But we can approximate for now
      
      const start1 = -h1 + 450;
      const end1 = 0;

      const start2 = 500;
      const end2 = -h2 + winH;

      const scrollDistance = Math.max(h1, h2) * 1.5;

      gsap.set(col1Inner, { y: start1 });
      gsap.set(col2Inner, { y: start2 });

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: worksDesktop,
          start: "top top",
          end: "+=" + scrollDistance,
          scrub: 1.2,
          pin: true,
          anticipatePin: 1
        }
      });

      tl.to(col1Inner, { y: end1, ease: "none" }, 0);
      tl.to(col2Inner, { y: end2, ease: "none" }, 0);

      // Handle interactions
      const tiles = worksDesktop.querySelectorAll('.tile');
      let activeTile: Element | null = null;
      let isLocked = false;

      function activateTile(tile: HTMLElement) {
        // Unlock if another is active
        if (activeTile && activeTile !== tile) {
          unlockAll();
        }

        activeTile = tile;
        isLocked = true;
        worksDesktop?.classList.add('-locked');

        // Find parent column and wrapper
        const wrapper = tile.closest('.tile-wrapper') as HTMLElement;
        const colWrap = tile.closest('.col-wrap') as HTMLElement;
        const isCol1 = colWrap.id === 'col1-wrap';

        // Animate tile itself
        tile.classList.add('-active');
        const desc = wrapper.querySelector('.tile-desc') as HTMLElement;
        if (desc) desc.style.opacity = '1';

        // Calculate scroll target to center this tile
        // local Y of the tile center relative to the column inner
        const tileRect = tile.getBoundingClientRect();
        const innerRect = (isCol1 ? col1Inner : col2Inner).getBoundingClientRect();
        
        // This calculates the center of the tile relative to the top of its column
        const tileCenterLocal = (tileRect.top - innerRect.top) + (tileRect.height / 2);
        
        const start = isCol1 ? start1 : start2;
        const end = isCol1 ? end1 : end2;
        
        // We want: start + progress * (end - start) + tileCenterLocal = winH / 2
        // progress = (winH / 2 - tileCenterLocal - start) / (end - start)
        let progress = (winH / 2 - tileCenterLocal - start) / (end - start);
        
        // Clamp progress
        progress = Math.max(0, Math.min(1, progress));

        const triggerStart = tl.scrollTrigger?.start || 0;
        const targetScrollY = triggerStart + progress * scrollDistance;

        // Use Lenis to scroll smoothly
        if ((window as any).lenis) {
          (window as any).lenis.scrollTo(targetScrollY, { duration: 1.2, easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)) });
          
          // Lock lenis after scrolling
          setTimeout(() => {
            if (isLocked) (window as any).lenis.stop();
          }, 1200);
        }

        // Push siblings
        const siblingWrappers = colWrap.querySelectorAll('.tile-wrapper');
        const expandScale = 1.35;
        const pushY = (tileRect.height * (expandScale - 1)) / 2;

        siblingWrappers.forEach(w => {
          if (w === wrapper) return;
          const isAbove = w.compareDocumentPosition(wrapper) & Node.DOCUMENT_POSITION_FOLLOWING;
          if (isAbove) {
            (w as HTMLElement).style.transform = `translateY(-${pushY}px)`;
          } else {
            (w as HTMLElement).style.transform = `translateY(${pushY}px)`;
          }
        });
      }

      function unlockAll() {
        isLocked = false;
        worksDesktop?.classList.remove('-locked');
        if ((window as any).lenis) {
          (window as any).lenis.start();
        }

        tiles.forEach(t => {
          t.classList.remove('-active');
          const desc = t.closest('.tile-wrapper')?.querySelector('.tile-desc') as HTMLElement;
          if (desc) desc.style.opacity = '0';
        });

        const wrappers = worksDesktop?.querySelectorAll('.tile-wrapper');
        wrappers?.forEach(w => {
          (w as HTMLElement).style.transform = '';
        });
        activeTile = null;
      }

      tiles.forEach((tile) => {
        tile.addEventListener('click', (e) => {
          if (isLocked) {
            if (tile === activeTile) {
              window.location.href = tile.getAttribute('href') || '';
            } else {
              e.preventDefault();
              activateTile(tile as HTMLElement);
            }
            return;
          }
          
          e.preventDefault();
          activateTile(tile as HTMLElement);
        });
      });

      window.addEventListener('click', (e) => {
        if (isLocked && !(e.target as Element).closest('.tile')) {
          unlockAll();
        }
      });

      return () => {
        tl.kill();
      };
    });
  });
</script>
