---

<!-- 背景由共用的 #stage-bg 提供:hero 幻燈片捲動時液態玻璃化,無縫成為此區背景 -->
<section id="works-section" class="relative z-10 w-full text-neutral-900">

  <div class="relative z-10">

    <!-- Gallery intro — 從 hero 落下後的第一個畫面 -->
    <header class="flex flex-col items-center justify-center text-center pt-[15vh] pb-[8vh] px-6 select-none">
      <p class="text-[0.6rem] tracking-[0.5em] text-neutral-400 mb-6">SELECTED WORKS</p>
      <p id="works-count" class="mt-7 text-[0.65rem] tracking-[0.35em] text-neutral-400" style="font-variant-numeric: tabular-nums;">2008 — PRESENT</p>
    </header>

    <!-- 長卷軸畫廊(JS 注入) -->
    <div id="works-gallery" class="relative w-full max-w-[1600px] mx-auto px-5 md:px-[6vw] pb-[8vh]"></div>

    <!-- Gallery end -->
    <footer class="flex flex-col items-center justify-center text-center pt-[8vh] pb-[12vh] px-6">
      <span class="wk-int-line"></span>
      <p class="mt-8 text-[0.6rem] tracking-[0.5em] text-neutral-400">TOWAN DIGITAL IMAGE</p>
      <p class="mt-5 max-w-md text-sm leading-[2.3] tracking-wider text-neutral-600">讓我們一起,創造屬於你的美麗畫面。</p>
      <a href={import.meta.env.BASE_URL + "contact"} class="mt-9 text-[0.62rem] tracking-[0.4em] text-neutral-400 hover:text-neutral-900 transition-colors duration-500 no-underline">GET IN TOUCH →</a>
    </footer>

  </div>

</section>

<style is:global>
  /* preflight 未全域生效,區域內自行確保 border-box,避免 width:100% + padding 溢出 */
  #works-section,
  #works-section *,
  #works-section *::before,
  #works-section *::after { box-sizing: border-box; }

  /* ---------- 畫廊節奏:中央大圖 / 左 / 右 交錯(大膽縮小,呼吸感加倍) ---------- */
  #works-gallery .wk-item {
    position: relative;
    width: 100%;
    margin: 8vh auto;
  }
  @media (min-width: 768px) {
    #works-gallery .wk-item--c { width: min(42%, 460px); margin: 8vh auto; }
    #works-gallery .wk-item--l { width: min(30%, 360px); margin: 4vh auto 4vh 8%; }
    #works-gallery .wk-item--r { width: min(30%, 360px); margin: 4vh 8% 4vh auto; }
  }

  /* 編號(左上,僅數字) */
  #works-gallery .wk-meta {
    margin-bottom: 13px;
    font-size: 10px;
    letter-spacing: 0.3em;
    color: rgba(23, 23, 23, 0.38);
    font-variant-numeric: tabular-nums;
  }

  /* ---------- 卡片:點擊懸浮凸起 ---------- */
  #works-gallery .wk-card {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 10px;
    background: #e9e9ec;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    box-shadow: 0 1px 3px rgba(20, 20, 30, 0.07), 0 8px 24px rgba(20, 20, 30, 0.06);
    transition: transform 0.55s cubic-bezier(0.22, 0.61, 0.36, 1), box-shadow 0.55s ease;
    will-change: transform;
  }
  @media (hover: hover) {
    #works-gallery .wk-item:not(.is-open) .wk-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 2px 6px rgba(20, 20, 30, 0.07), 0 18px 40px rgba(20, 20, 30, 0.12);
    }
  }
  #works-gallery .wk-item.is-open .wk-card {
    transform: translateY(-10px) scale(1.015);
    box-shadow: 0 4px 10px rgba(20, 20, 30, 0.08), 0 34px 70px rgba(20, 20, 30, 0.2);
  }
  #works-gallery .wk-media {
    position: relative;
    aspect-ratio: 7 / 4;
    overflow: hidden;
  }
  /* 視差層:比框高 14%,由 GSAP 上下位移 */
  #works-gallery .wk-par {
    position: absolute;
    inset: -7% 0;
    will-change: transform;
  }
  #works-gallery .wk-par img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ---------- 圖下方:分類(右)+ 點擊展開的文案(左) ---------- */
  #works-gallery .wk-below {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    margin-top: 12px;
  }
  #works-gallery .wk-cat {
    flex: 0 0 auto;
    order: 2;
    font-size: 0.6rem;
    letter-spacing: 0.35em;
    color: rgba(23, 23, 23, 0.38);
    text-transform: uppercase;
    white-space: nowrap;
    padding-top: 2px;
  }
  #works-gallery .wk-copy {
    flex: 1 1 auto;
    order: 1;
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.6s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  #works-gallery .wk-copy-in {
    overflow: hidden;
    min-height: 0;
    text-align: left;
  }
  #works-gallery .wk-item.is-open .wk-copy { grid-template-rows: 1fr; }

  #works-gallery .wk-copy-in > * {
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  #works-gallery .wk-item.is-open .wk-copy-in > * { opacity: 1; transform: none; }
  #works-gallery .wk-item.is-open .wk-copy-in > *:nth-child(2) { transition-delay: 0.08s; }
  #works-gallery .wk-item.is-open .wk-copy-in > *:nth-child(3) { transition-delay: 0.16s; }
  #works-gallery .wk-item.is-open .wk-copy-in > *:nth-child(4) { transition-delay: 0.26s; }

  #works-gallery .wk-title {
    padding-top: 8px;
    font-size: clamp(1.05rem, 2vw, 1.5rem);
    font-weight: 600;
    letter-spacing: 0.05em;
    line-height: 1.3;
    color: #171717;
  }
  #works-gallery .wk-sub {
    margin-top: 6px;
    font-size: 0.82rem;
    letter-spacing: 0.1em;
    color: rgba(23, 23, 23, 0.62);
  }
  #works-gallery .wk-desc {
    margin-top: 12px;
    max-width: 46ch;
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    line-height: 1.8;
    color: rgba(23, 23, 23, 0.55);
  }

  /* ---------- 間場:about 段落的呼吸空間 ---------- */
  #works-gallery .wk-interlude {
    min-height: 32vh;
    width: 100% !important;
    margin: 6vh auto !important;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 24px;
  }
  .wk-int-line {
    display: block;
    width: 1px;
    height: 64px;
    background: linear-gradient(to bottom, rgba(23, 23, 23, 0), rgba(23, 23, 23, 0.35));
  }
  #works-gallery .wk-interlude h3 {
    margin: 30px 0 24px;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.55em;
    text-indent: 0.55em; /* 平衡置中 */
    color: rgba(23, 23, 23, 0.5);
  }
  #works-gallery .wk-interlude p {
    max-width: 34em;
    font-size: 0.85rem;
    line-height: 2.4;
    letter-spacing: 0.09em;
    color: rgba(23, 23, 23, 0.62);
  }
  #works-gallery .wk-interlude a {
    margin-top: 32px;
    font-size: 0.58rem;
    letter-spacing: 0.4em;
    color: rgba(23, 23, 23, 0.35);
    text-decoration: none;
    transition: color 0.4s ease;
  }
  #works-gallery .wk-interlude a:hover { color: #171717; }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { ScrollToPlugin } from 'gsap/ScrollToPlugin';

  gsap.registerPlugin(ScrollTrigger, ScrollToPlugin);

  // 穿插於作品之間的 about 段落(節錄自 about 頁)
  const INTERLUDES = [
    {
      head: '有機圖王',
      text: '圖王不是礦石,而是有機物;我們吸收水分、我們補充養分、我們光合作用,我們迎風搖曳。',
    },
    {
      head: '開眼美麗',
      text: '「出生後睜開眼的第一瞬間,映入眼簾的盡是美麗的畫面。」我們期許自身不斷地創造美麗畫面,創造屬於我們自己的「開眼美麗」。',
    },
    {
      head: '該聽誰的',
      text: '我們的設計不為業主的喜好,不為設計師的主觀,只為作品本身清澈的靈魂。',
    },
    {
      head: '沉澱',
      text: '這些作品,是我們在工作上擂鼓、衝鋒、嘶喊、獻技之後所沉澱下來的畫面 —— 喧囂之後,靜謐、無噪、沉著、自觀。',
    },
    {
      head: '美學資產',
      text: '將設計作品一件一件、像藝術品般的收藏與陳列 —— 無形的競爭力大方崛起,有形的資產不斷累積。',
    },
  ];

  document.addEventListener('astro:page-load', async () => {
    const gallery = document.getElementById('works-gallery');
    if (!gallery) return;

    const BASE = import.meta.env.BASE_URL;

    // 背景幻燈片改由共用的 #stage-bg 播放(見 StageBackground.astro)

    let projects: any[] = [];
    try {
      const res = await fetch(BASE + 'data/works.json');
      if (!res.ok) throw new Error('Failed to fetch works data');
      projects = (await res.json()).filter((p: any) => p.image);
    } catch (err) {
      console.error('Failed to load works data:', err);
      return;
    }

    const total = projects.length;
    const countEl = document.getElementById('works-count');
    if (countEl) countEl.textContent = `${String(total).padStart(3, '0')} WORKS / 2008 — PRESENT`;

    const esc = (s: any) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    const srcOf = (img: string) => img.startsWith('http') ? img : BASE + img.replace(/^\//, '');

    // 每隔 step 件作品插入一段間場文字
    const step = Math.ceil(total / (INTERLUDES.length + 1));
    const alignCycle = ['c', 'l', 'r']; // 中央大圖 → 左 → 右,循環

    let html = '';
    let interludeIdx = 0;

    projects.forEach((p: any, i: number) => {
      const align = alignCycle[i % alignCycle.length];
      const num = String(i + 1).padStart(3, '0');

      html += `
        <div class="wk-item wk-item--${align}">
          <div class="wk-meta">${num} / ${String(total).padStart(3, '0')}</div>
          <a class="wk-card" href="${BASE}works/view?id=${encodeURIComponent(p.id)}" aria-label="${esc(p.title)}">
            <div class="wk-media">
              <div class="wk-par">
                <img src="${srcOf(p.image)}" alt="${esc(p.title)}" loading="lazy" decoding="async" />
              </div>
            </div>
          </a>
          <div class="wk-below">
            <div class="wk-copy">
              <div class="wk-copy-in">
                <h3 class="wk-title">${esc(p.title)}</h3>
                <p class="wk-sub">${esc(p.subtitle)}</p>
                ${p.description ? `<p class="wk-desc">${esc(p.description)}</p>` : ''}
              </div>
            </div>
            <span class="wk-cat">${esc(p.category)}</span>
          </div>
        </div>
      `;

      // 間場
      if ((i + 1) % step === 0 && interludeIdx < INTERLUDES.length && i < total - 1) {
        const s = INTERLUDES[interludeIdx++];
        html += `
          <div class="wk-item wk-interlude">
            <span class="wk-int-line"></span>
            <h3>${s.head}</h3>
            <p>${s.text}</p>
            <a href="${BASE}about">MORE ABOUT TOWAN →</a>
          </div>
        `;
      }
    });

    gallery.innerHTML = html;

    /* ---------- 兩段式點擊:一按懸浮凸起 + 展開文案,再按進入 ---------- */
    const closeAll = (except?: Element | null) => {
      gallery.querySelectorAll('.wk-item.is-open').forEach((c) => { if (c !== except) c.classList.remove('is-open'); });
    };

    const ac = new AbortController();
    const { signal } = ac;

    // 點擊追蹤:平滑捲動,把該作品置中於視窗
    const centerOn = (el: Element) => {
      const rect = el.getBoundingClientRect();
      const target = window.scrollY + rect.top + rect.height / 2 - window.innerHeight / 2;
      gsap.to(window, {
        scrollTo: { y: Math.max(0, target), autoKill: true },
        duration: 0.9,
        ease: 'power2.inOut',
      });
    };

    gallery.addEventListener('click', (e) => {
      const card = (e.target as Element).closest('a.wk-card');
      if (!card) return;
      const item = card.closest('.wk-item')!;
      if (!item.classList.contains('is-open')) {
        e.preventDefault();
        closeAll(item);
        item.classList.add('is-open');
        // 展開文案會改變高度,等版面穩定後再置中
        requestAnimationFrame(() => requestAnimationFrame(() => centerOn(card)));
      }
      // 已開啟 → 放行,自然導向作品頁
    }, { signal });

    document.addEventListener('click', (e) => {
      if (!(e.target as Element).closest('.wk-card')) closeAll();
    }, { signal });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeAll();
    }, { signal });

    /* ---------- 滾動效果 ---------- */
    const triggers: ScrollTrigger[] = [];

    // 進場顯現:淡入 + 上浮
    gallery.querySelectorAll('.wk-item').forEach((el) => {
      const isInterlude = el.classList.contains('wk-interlude');
      const tween = gsap.fromTo(el,
        { autoAlpha: 0, y: isInterlude ? 40 : 72 },
        {
          autoAlpha: 1, y: 0,
          duration: isInterlude ? 1.6 : 1.15,
          ease: 'power3.out',
          scrollTrigger: { trigger: el, start: 'top 88%', once: true },
        }
      );
      if (tween.scrollTrigger) triggers.push(tween.scrollTrigger);
    });

    // 間場的線:緩緩長出
    gallery.querySelectorAll('.wk-interlude .wk-int-line').forEach((el) => {
      const tween = gsap.fromTo(el,
        { scaleY: 0, transformOrigin: 'top center' },
        {
          scaleY: 1, duration: 1.4, ease: 'power2.out',
          scrollTrigger: { trigger: el, start: 'top 82%', once: true },
        }
      );
      if (tween.scrollTrigger) triggers.push(tween.scrollTrigger);
    });

    // 圖片視差:滾過時緩慢位移
    gallery.querySelectorAll('.wk-par').forEach((el) => {
      const tween = gsap.fromTo(el,
        { yPercent: -5 },
        {
          yPercent: 5, ease: 'none',
          scrollTrigger: {
            trigger: el.closest('.wk-media'),
            start: 'top bottom',
            end: 'bottom top',
            scrub: true,
          },
        }
      );
      if (tween.scrollTrigger) triggers.push(tween.scrollTrigger);
    });

    // 換頁時清乾淨,避免 ScrollTrigger 疊加
    document.addEventListener('astro:before-swap', () => {
      triggers.forEach((t) => t.kill());
      ac.abort();
    }, { once: true });
  });
</script>
