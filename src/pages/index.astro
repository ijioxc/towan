---
import Base from '../layouts/Base.astro';
import HeroSection from '../components/HeroSection.astro';
import WorksSection from '../components/WorksSection.astro';
---

<Base title="TOWAN 數位影像" heroNav={true}>
  
  <!-- Dynamic NAV for the SPA -->
  <div id="spa-header" class="box-border fixed z-50 px-5 md:px-8 py-5 md:py-6 flex items-center justify-between pointer-events-none transition-colors duration-500" style="top: 2.5vh; left: 2.5vw; right: 2.5vw;">
    <a href={import.meta.env.BASE_URL} class="pointer-events-auto hover:opacity-50 transition-opacity inline-block translate-x-4 translate-y-2">
      <img src={import.meta.env.BASE_URL + "images/towanlogo3.png"} alt="TOWAN" class="h-5 nav-img transition-all duration-500" />
    </a>
    <nav class="flex items-center text-[10px] sm:text-xs tracking-widest uppercase font-normal pointer-events-auto nav-links">
      <a href="#works-section" class="text-white/60 hover:text-white transition-colors duration-500 no-underline mr-2 sm:mr-4 md:mr-7">WORKS</a>
      <a href={import.meta.env.BASE_URL + "about"} class="text-white/60 hover:text-white transition-colors duration-500 no-underline mr-2 sm:mr-4 md:mr-7">ABOUT</a>
      <a href={import.meta.env.BASE_URL + "contact"} class="text-white/60 hover:text-white transition-colors duration-500 no-underline mr-2 sm:mr-4 md:mr-7">CONTACT</a>
      <a href="https://www.facebook.com/%E5%9C%96%E7%8E%8B%E6%95%B8%E4%BD%8D%E5%BD%B1%E5%83%8F%E6%9C%89%E9%99%90%E5%85%AC%E5%8F%B8-1418615315071832/" target="_blank" class="hover:opacity-60 transition-opacity mr-1 sm:mr-2 md:mr-4">
        <img src={import.meta.env.BASE_URL + "images/icon-a.png"} alt="social" class="h-[14px] md:h-[16px] nav-icon transition-all duration-500" style="filter: brightness(0) invert(1);" />
      </a>
      <a href="mailto:towan@towan.com.tw" class="hover:opacity-60 transition-opacity">
        <img src={import.meta.env.BASE_URL + "images/icon-b.png"} alt="contact" class="h-[14px] md:h-[16px] nav-icon transition-all duration-500" style="filter: brightness(0) invert(1);" />
      </a>
    </nav>
  </div>

  <HeroSection />
  <WorksSection />

</Base>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import Lenis from 'lenis';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('astro:page-load', () => {
    const spaHeader = document.getElementById('spa-header');
    if (!spaHeader) return;

    // Smooth scroll for WORKS link in header
    const worksLink = spaHeader.querySelector('a[href="#works-section"]');
    if (worksLink) {
      worksLink.addEventListener('click', (e) => {
        e.preventDefault();
        if ((window as any).lenis) {
          (window as any).lenis.scrollTo('#works-section');
        } else {
          document.querySelector('#works-section')?.scrollIntoView({ behavior: 'smooth' });
        }
      });
    }

    // Change nav colors based on scroll position
    // We trigger the color change when the Works section hits the top of the screen
    ScrollTrigger.create({
      trigger: "#works-section",
      start: "top 5%", // when top of works section hits 5% from top of viewport
      onEnter: () => setNavDark(),
      onLeaveBack: () => setNavLight()
    });

    function setNavDark() {
      // Switch logo to dark version or apply filter
      gsap.to('#spa-header .nav-img', { filter: 'invert(1) brightness(0)', duration: 0.5 });
      gsap.to('#spa-header .nav-icon', { filter: 'brightness(0)', duration: 0.5 });
      
      const links = document.querySelectorAll('#spa-header .nav-links a.text-white\\/60, #spa-header .nav-links a.text-white');
      links.forEach(l => {
        l.classList.remove('text-white/60', 'hover:text-white', 'text-white');
        l.classList.add('text-black/60', 'hover:text-black');
      });
    }

    function setNavLight() {
      // Switch logo back to light
      gsap.to('#spa-header .nav-img', { filter: 'none', duration: 0.5 });
      gsap.to('#spa-header .nav-icon', { filter: 'brightness(0) invert(1)', duration: 0.5 });

      const links = document.querySelectorAll('#spa-header .nav-links a.text-black\\/60, #spa-header .nav-links a.text-black');
      links.forEach(l => {
        l.classList.remove('text-black/60', 'hover:text-black', 'text-black');
        l.classList.add('text-white/60', 'hover:text-white');
      });
    }
  });
</script>
