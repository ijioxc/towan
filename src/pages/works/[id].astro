---
import Base from '../../layouts/Base.astro';
import type { GetStaticPaths } from 'astro';
import { readFileSync } from 'fs';
import { join } from 'path';

export const getStaticPaths = (async () => {
  const indexPath = join(process.cwd(), 'src/pages/works/index.json');
  const projects = JSON.parse(readFileSync(indexPath, 'utf-8'));
  return projects.map((p: any) => ({ params: { id: p.id } }));
}) satisfies GetStaticPaths;

const { id } = Astro.params;
const indexPath = join(process.cwd(), 'src/pages/works/index.json');
const projects = JSON.parse(readFileSync(indexPath, 'utf-8'));
const project = projects.find((p: any) => p.id === id);
---
<Base title={`${project.title} — TOWAN`}>
  <div class="max-w-4xl mx-auto px-6 py-12 pb-24">
    <a href={import.meta.env.BASE_URL + "works"} class="text-xs tracking-widest text-neutral-400 hover:text-neutral-900 transition-colors mb-8 inline-block">← WORKS</a>

    <div class="mb-10">
      <div class="flex gap-2 flex-wrap mb-3">
        {project.category && (
          <span class="text-[0.6rem] tracking-widest text-neutral-500 bg-neutral-100 px-2 py-1">{project.category}</span>
        )}
      </div>
      <h1 class="text-4xl font-bold tracking-wide">{project.title}</h1>
      {project.subtitle && <p class="mt-2 text-neutral-500">{project.subtitle}</p>}
    </div>

    <div class="flex flex-col gap-2" id="project-images">
      {project.inner_images && project.inner_images.map((img: string, index: number) => (
        <div class="relative w-full mb-10 project-img opacity-0 translate-y-6">
          <img
            src={`${import.meta.env.BASE_URL}media/work/${project.inner_folder}/${img}`}
            alt=""
            loading="lazy"
            decoding="async"
            class="w-full h-auto block"
          />
        </div>
      ))}
    </div>
  </div>
</Base>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  document.addEventListener('astro:page-load', () => {
    gsap.registerPlugin(ScrollTrigger);

    gsap.utils.toArray<HTMLElement>('.project-img').forEach((el) => {
      gsap.to(el, {
        opacity: 1, y: 0, duration: 0.9, ease: 'power2.out',
        scrollTrigger: { trigger: el, start: 'top 90%' },
      });
    });
  });
</script>
