---
// Runtime-rendered About page: reads /data/about.json so text and font sizes
// edited from the admin panel show up without a rebuild.
import Base from '../layouts/Base.astro';
---
<Base title="About — TOWAN" heroNav={true}>
  <!-- Nav identical position to index.astro -->
  <div class="box-border fixed z-50 px-5 md:px-8 py-5 md:py-6 flex items-center justify-between pointer-events-none text-black"
    style="top: 2.5vh; left: 2.5vw; right: 2.5vw;">
    <a href={import.meta.env.BASE_URL} class="pointer-events-auto hover:opacity-50 transition-opacity inline-block translate-x-4 translate-y-2">
      <img src={import.meta.env.BASE_URL + "images/towanlogo-BLK.png"} alt="TOWAN" class="h-5" />
    </a>
        <nav class="flex items-center text-[10px] sm:text-xs tracking-widest uppercase pointer-events-auto font-normal">
      <a href={import.meta.env.BASE_URL + "works"} class="text-black/60 hover:text-black transition-colors no-underline mr-2 sm:mr-4 md:mr-7">WORKS</a>
      <a href={import.meta.env.BASE_URL + "about"} class="text-black transition-colors no-underline mr-2 sm:mr-4 md:mr-7">ABOUT</a>
      <a href={import.meta.env.BASE_URL + "contact"} class="text-black/60 hover:text-black transition-colors no-underline mr-2 sm:mr-4 md:mr-7">CONTACT</a>
      <a href="https://www.facebook.com/%E5%9C%96%E7%8E%8B%E6%95%B8%E4%BD%8D%E5%BD%B1%E5%83%8F%E6%9C%89%E9%99%90%E5%85%AC%E5%8F%B8-1418615315071832/" target="_blank" class="hover:opacity-60 transition-opacity mr-1 sm:mr-2 md:mr-4">
        <img src={import.meta.env.BASE_URL + "images/icon-a.png"} alt="social" class="h-[14px] md:h-[16px]" style="filter: brightness(0);" />
      </a>
      <a href="mailto:towan@towan.com.tw" class="hover:opacity-60 transition-opacity">
        <img src={import.meta.env.BASE_URL + "images/icon-b.png"} alt="contact" class="h-[14px] md:h-[16px]" style="filter: brightness(0);" />
      </a>
    </nav>
  </div>

  <div class="w-full max-w-5xl mx-auto min-h-screen pt-40 pb-20 px-6 sm:px-12 md:px-24 flex flex-col items-center text-center">
    <img src={import.meta.env.BASE_URL + "images/towanpattern.png"} alt="Pattern" class="h-32 mb-12 opacity-80" />
    <div id="about-content" class="w-full flex flex-col items-center"></div>
  </div>
</Base>

<script>
  async function initAboutPage() {
    const root = document.getElementById('about-content');
    if (!root || root.dataset.rendered) return;

    const base = import.meta.env.BASE_URL;
    let data: { blocks?: any[] } = {};
    try {
      const res = await fetch(`${base}data/about.json`, { cache: 'no-cache' });
      data = await res.json();
    } catch {
      root.innerHTML = '<p class="text-sm text-neutral-500">Unable to load content.</p>';
      return;
    }

    root.dataset.rendered = '1';

    const esc = (s: string) => String(s ?? '').replace(/[&<>"']/g, (c) => (
      { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string
    ));

    const TYPE_CLASS: Record<string, string> = {
      h1: 'tracking-[0.2em] font-bold w-full max-w-2xl text-center',
      h2: 'tracking-[0.4em] text-neutral-500 w-full max-w-2xl text-center',
      p: 'tracking-wider text-neutral-600 w-full max-w-2xl text-center',
    };
    const TAG: Record<string, string> = { h1: 'h1', h2: 'h2', p: 'p' };

    const blocks = data.blocks || [];
    root.innerHTML = blocks.map((b: any) => {
      const tag = TAG[b.type] || 'p';
      const cls = TYPE_CLASS[b.type] || TYPE_CLASS.p;
      const style = `font-size:${Number(b.size) || 14}px;margin-bottom:${Number(b.mb) || 0}px;${b.leading ? `line-height:${Number(b.leading)};` : ''}`;
      return `<${tag} class="${cls}" style="${style}">${esc(b.text)}</${tag}>`;
    }).join('');
  }

  initAboutPage();
  document.addEventListener('astro:page-load', initAboutPage);
</script>
